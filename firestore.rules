rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Users collection: user can read/write their own profile
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (request.auth.uid == userId || request.auth.uid == request.resource.data.userId);

      match /video_progress/{lessonId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }
    }

    // Activation Codes collection: readable by authenticated users to validate, manageable by owner or authenticated
    match /activation_codes/{codeId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Video progress collection
    match /video_progress/{progressId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
  }
}
